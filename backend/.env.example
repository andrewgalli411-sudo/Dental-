# Copy to .env for local dev. NEVER commit a real .env.
# In deployed environments these come from AWS Secrets Manager, not a file.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Local Postgres (docker: postgres:16). psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://verifi:verifi@localhost:5432/verifi

AWS_REGION=us-east-1
S3_BUCKET_UPLOADS=
S3_BUCKET_REPORTS=

UPLOAD_TOKEN_TTL_HOURS=36
REPORT_TOKEN_TTL_DAYS=7
PHI_RETENTION_DAYS=7
